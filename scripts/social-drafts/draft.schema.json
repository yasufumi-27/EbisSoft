{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category",
    "headline",
    "summary",
    "caption",
    "hashtags",
    "slides",
    "sources"
  ],
  "properties": {
    "category": { "type": "string", "enum": ["AIニュース", "AI知識"] },
    "headline": { "type": "string", "minLength": 8, "maxLength": 44 },
    "summary": {
      "type": "string",
      "minLength": 30,
      "maxLength": 76,
      "pattern": "[。！？]$"
    },
    "caption": { "type": "string", "minLength": 80, "maxLength": 900 },
    "hashtags": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": { "type": "string", "pattern": "^#[^\\s#]+$" }
    },
    "slides": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["heading", "body"],
        "properties": {
          "heading": { "type": "string", "minLength": 4, "maxLength": 34 },
          "body": { "type": "string", "minLength": 30, "maxLength": 180 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "url"],
        "properties": {
          "label": { "type": "string", "minLength": 2, "maxLength": 80 },
          "url": { "type": "string", "minLength": 12, "maxLength": 500 }
        }
      }
    }
  }
}
